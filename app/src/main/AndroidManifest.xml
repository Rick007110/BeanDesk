<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".BeanDeskApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher_espresso"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_espresso"
        android:supportsRtl="true"
        android:theme="@style/Theme.BeanDesk">

        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <!--
            One launcher entry per app icon. Exactly one is enabled at a time; the app switches
            them in AppIconManager. Keep these in sync with the AppIcon enum. Espresso is the
            default and the only one enabled here.
        -->
        <activity-alias
            android:name=".LauncherEspresso"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_espresso"
            android:roundIcon="@mipmap/ic_launcher_espresso"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherTerracotta"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_terracotta"
            android:roundIcon="@mipmap/ic_launcher_terracotta"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherCrema"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_crema"
            android:roundIcon="@mipmap/ic_launcher_crema"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherTeal"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_teal"
            android:roundIcon="@mipmap/ic_launcher_teal"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherNight"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_night"
            android:roundIcon="@mipmap/ic_launcher_night"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
