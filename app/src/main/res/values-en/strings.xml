    <string name="privacy_section">Privacy</string>
    <string name="privacy_title">Privacy statement</string>
    <string name="privacy_location_title">Your location</string>
    <string name="privacy_location_body">BeanDesk only uses your location when you allow it, and only while you use the app. The app works out distances on your phone; your location goes nowhere.</string>
    <string name="privacy_reports_title">Reports and stars</string>
    <string name="privacy_reports_body">With your first report BeanDesk creates an anonymous account, without a name, email address or phone number. Your reports and stars are stored with that account in the database on our own server at Bluehost, in a data centre in Amsterdam (Bluehost is an American company), so you can see them here and we can fight abuse. Others only see the totals per place, never who reported what.</string>
    <string name="privacy_search_title">Search</string>
    <string name="privacy_search_body">What you type in the search field goes to our server. It looks up the town or address at PDOK (the Dutch government\'s location service) and gets places from OpenStreetMap. Your search is not linked to your account.</string>
    <string name="privacy_map_title">Map and route</string>
    <string name="privacy_map_body">The map loads map images from OpenFreeMap, which therefore sees your IP address and the part of the map you view. A route opens in Google Maps, where Google\'s privacy policy applies.</string>
    <string name="privacy_delete_title">Deleting</string>
    <string name="privacy_delete_body">Delete account below removes your account, reports and stars at once and for good. What they added to a place\'s information is then worked out again. BeanDesk has no ads and does not track you.</string>

    <string name="account_anonymous">Your account is anonymous: no name or email address is attached to it.</string>
