# Copy to .env (never into the repository) and fill in; see docs/vps.md.

# The DuckDNS name of this server.
DOMAIN=beandesk.duckdns.org

# The API's database user, made by deploy/migrate.sh with the same password.
DATABASE_URL=postgresql://beandesk_api:CHANGE_ME@127.0.0.1:5432/beandesk

# Signs the tokens of accounts: openssl rand -hex 32. Changing it logs every phone out.
JWT_SECRET=

# Where the API listens on this server; only Caddy talks to it.
PORT=8080
